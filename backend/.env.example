TOSSINVEST_CLIENT_ID=<tossinvest client id>
TOSSINVEST_CLIENT_SECRET=<tossinvest client secret>
# 계좌번호 또는 accountSeq를 넣습니다. 계좌번호를 넣으면 백엔드가 계좌 목록에서 accountSeq로 매칭합니다.
TOSSINVEST_ACCOUNT=<tossinvest account number or accountSeq>
# 실제 주문 전송을 허용하려면 true로 바꾸고, 주문 가능한 Firebase 이메일을 쉼표로 지정합니다.
TOSSINVEST_TRADING_ENABLED=false
TOSSINVEST_TRADING_ALLOWED_EMAILS=<allowed firebase email>

UPBIT_API_BASE_URL=https://api.upbit.com
UPBIT_ACCESS_KEY=<upbit access key>
UPBIT_SECRET_KEY=<upbit secret key>
# 실제 코인 주문 전송을 허용하려면 true로 바꾸고, 주문 가능한 Firebase 이메일을 쉼표로 지정합니다.
UPBIT_TRADING_ENABLED=false
UPBIT_TRADING_ALLOWED_EMAILS=<allowed firebase email>

