# Copy this file to .env in the repository root.
# Real secrets must stay in .env or backend/.env, never in git.

APP_PUBLIC_URL=https://www.kang.ai.kr
HTTP_USER_AGENT=KangPrivateHub/1.0 (+https://www.kang.ai.kr)
BROWSER_USER_AGENT=Mozilla/5.0 (compatible; KangPrivateHub/1.0; +https://www.kang.ai.kr)

# Flutter compile-time values. scripts/flutter_run_with_env.ps1 passes these
# to Flutter as --dart-define values.
API_BASE_URL=https://www.kang.ai.kr
FIREBASE_API_KEY=<firebase api key>
FIREBASE_PROJECT_ID=kang-84cdd
FIREBASE_WEB_APP_ID=<firebase web app id>
FIREBASE_MESSAGING_SENDER_ID=<firebase messaging sender id>
FIREBASE_AUTH_DOMAIN=kang-84cdd.firebaseapp.com
FIREBASE_STORAGE_BUCKET=kang-84cdd.firebasestorage.app
FIREBASE_ANDROID_APP_ID=<firebase android app id>
FIREBASE_IOS_APP_ID=<firebase ios app id>
FIREBASE_IOS_BUNDLE_ID=<firebase ios bundle id>

# Backend database. DATABASE_URL may be used instead of the split POSTGRES_*
# values, but it must still point to 211.47.74.33/dbkang as user kang.
POSTGRES_HOST=211.47.74.33
POSTGRES_PORT=5432
POSTGRES_DB=dbkang
POSTGRES_USER=kang
POSTGRES_PASSWORD=<db password>
# DATABASE_URL=postgresql://kang:<db password>@211.47.74.33:5432/dbkang

# Backend Firebase Admin credentials. Use one of the credential options.
KANG_FIREBASE_PROJECT_ID=kang-84cdd
GOOGLE_APPLICATION_CREDENTIALS=<firebase service account json path>
FIREBASE_CREDENTIALS_JSON=

CORS_ALLOWED_ORIGINS=https://www.kang.ai.kr,https://kang.ai.kr,http://www.kang.ai.kr,http://kang.ai.kr,https://kang-84cdd.web.app,https://kang-84cdd.firebaseapp.com

ACADEMYINFO_SERVICE_KEY=<academyinfo service key>
SEOUL_SUBWAY_API_KEY=sample
SEOUL_SUBWAY_BASE_URL=http://swopenapi.seoul.go.kr/api/subway
DEFAULT_SUBWAY_STATION=야탑
DEFAULT_SUBWAY_LINE=수인분당선

SFTP_HOST=www.kang.ai.kr
SFTP_PORT=22
SFTP_USERNAME=<sftp username>
SFTP_PASSWORD=<sftp password>
SFTP_REMOTE_PATH=<sftp remote path>
